# 复制为 .env 并填写（.env 已在 .gitignore 中，不会提交）。vm 命令会自动读取。

# ---- 视频：Grok Imagine ----
XAI_API_KEY=
GROK_MODELS_BASE_URL=https://api.x.ai/v1      # 使用中转服务时改成中转地址
VM_VIDEO_MODEL=grok-imagine-video-1.5          # 1.5 仅支持图生视频

# ---- 图像：OpenAI 兼容接口（关键帧 / 设定图）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VM_IMAGE_API=responses                         # responses（Codex 方式）或 images
VM_IMAGE_CHAT_MODEL=gpt-5.5                    # responses 方式下驱动 image_generation 的模型
VM_IMAGE_MODEL=gpt-image-2.5                   # images 方式下的图像模型

# ---- 3D：Tripo3D ----
TRIPO_API_KEY=
# TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
